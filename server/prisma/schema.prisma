// Prisma schema for DevScribe
// Uses SQLite for portable, zero-configuration local database storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for registered accounts
model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  bio       String?  @default("")
  avatar    String?  @default("")
  createdAt DateTime @default(now())

  // Relations
  articles Article[]
  snippets Snippet[]
  comments Comment[]
  likes    Like[]
}

// Technical articles posted by users
model Article {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  summary    String?  @default("")
  content    String
  tags       String   @default("general") // comma-separated tags e.g. "react,javascript"
  coverImage String?  @default("")
  readTime   Int      @default(3)         // estimated read time in minutes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Foreign key for author
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Relations
  comments Comment[]
  likes    Like[]
}

// Reusable code snippets
model Snippet {
  id          String   @id @default(uuid())
  title       String
  description String?  @default("")
  code        String
  language    String   @default("javascript")
  createdAt   DateTime @default(now())

  // Foreign key for author
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// Reader comments under articles
model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  // Foreign keys
  userId    String
  articleId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// Likes on articles (one like per user per article)
model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  articleId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}
